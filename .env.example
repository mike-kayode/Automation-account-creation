APP_NAME=NairaTrader Demo MT5 Worker
EXNESS_URL=https://my.exness.com/pa/trading/accounts
BROWSER_PROFILE_PATH=./browser_profile/google-chrome
# attach = use your real open Chrome (recommended, avoids Google "browser not secure" block).
# launch = let Playwright open its own Chrome window with the profile above.
BROWSER_MODE=attach
BROWSER_CDP_ENDPOINT=http://127.0.0.1:9222
BROWSER_CHANNEL=chrome
# Optional: leave empty to use the installed Chrome channel.
BROWSER_EXECUTABLE_PATH=
DATABASE_PATH=./database/worker.db
EXPORT_DIRECTORY=./report
SCREENSHOT_DIRECTORY=./screenshots
# Account configuration - change these freely, everything else stays fixed:
# NICKNAME     = any nickname you want the demo accounts to have
# DEMO_DEPOSIT = account size (any positive amount in NGN)
# MAX_LEVERAGE = one of the options Exness offers:
#                1:2  1:20  1:50  1:100  1:200  1:400  1:500  1:600
#                1:800  1:1000  1:2000  1:Unlimited
NICKNAME=NairaTrader 1.5M
ACCOUNT_MODE=DEMO
ACCOUNT_TYPE=PRO
PLATFORM=MT5
CURRENCY=NGN
DEMO_DEPOSIT=1500000
MAX_LEVERAGE=1:100
PASSWORD_PREFIX=$Manager
MAX_PASSWORD_DIGITS=5
JOB_DELAY_MIN_SECONDS=5
JOB_DELAY_MAX_SECONDS=10
MAX_RETRIES=2
SESSION_CHECK_INTERVAL_SECONDS=2
ELEMENT_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
ENCRYPTION_KEY=
TEST_MODE=true
